{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ACCSCI/cc-productivity-plugins/tree/main/plugins/user-simulator/schemas/project-profile.schema.json",
  "title": "ProjectProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stack", "dev", "routes", "api", "ui", "smoke"],
  "properties": {
    "schema_version": { "type": "string", "const": "4.0" },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework"],
      "properties": {
        "framework": {
          "type": "string",
          "enum": [
            "next-app-router",
            "next-pages",
            "nuxt",
            "sveltekit",
            "vite-react",
            "electron-vite",
            "electron-vite-plugin",
            "electron-esbuild",
            "cloudflare-workers",
            "remix",
            "angular",
            "flask",
            "tauri",
            "unknown"
          ]
        },
        "version": { "type": "string" },
        "is_monorepo": { "type": "boolean", "default": false },
        "monorepo_tool": { "type": "string", "enum": ["pnpm", "turborepo", "lerna", "nx"] },
        "workspace_members": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "dev": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "port"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "maxLength": 500 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "readyTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000, "default": 60000 },
        "env": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["app-router", "pages", "src-routes", "electron-main", "config-based", "none"]
        },
        "entries": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 200
        },
        "main_entry": {
          "type": "string",
          "description": "For electron-main: path to main process file (e.g. electron/main.ts)"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface"],
      "properties": {
        "surface": {
          "type": "string",
          "enum": ["openapi", "graphql", "trpc-openapi", "rest", "none"]
        },
        "specUrl": {
          "type": "string",
          "description": "OpenAPI/GraphQL schema URL. e.g. /api/openapi.json or /graphql"
        },
        "endpoint": {
          "type": "string",
          "description": "API base URL for REST/GraphQL/tRPC operations"
        },
        "routeTable": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "path", "handler"],
            "properties": {
              "method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS", "HEAD"] },
              "path": { "type": "string" },
              "handler": { "type": "string" }
            }
          },
          "maxItems": 1000
        },
        "ipc_style": {
          "type": "string",
          "enum": ["typed", "generic-bridge", "hono-daemon", "none"],
          "description": "For Electron: how renderer talks to main"
        }
      }
    },
    "state": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["library"],
        "properties": {
          "library": {
            "type": "string",
            "enum": ["zustand", "redux", "pinia", "vuex", "mobx", "jotai", "valtio", "tanstack-query", "none"]
          },
          "stores": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentLib"],
      "properties": {
        "componentLib": {
          "type": "string",
          "enum": ["shadcn", "heroui", "mui", "chakra", "antd", "mantine", "base-ui", "tailwind-only", "none"]
        },
        "theme": { "type": "string" }
      }
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "selector": {
          "type": "string",
          "description": "Optional element to interact with for the scaffolded smoke test"
        }
      }
    },
    "existing_e2e": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "framework": { "type": "string", "enum": ["playwright", "vitest", "cypress", "jest", "none"] },
        "configPath": { "type": "string" },
        "testDir": { "type": "string" }
      },
      "description": "Set when the project already has an E2E setup; user-simulator will not scaffold over it"
    }
  }
}