{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ACCSCI/cc-productivity-plugins/tree/main/plugins/user-simulator/schemas/story.schema.json",
  "title": "Story (task | explore)",
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["schema_version", "kind", "id", "name", "mode"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "kind": { "type": "string", "const": "story" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "mode": { "type": "string", "enum": ["task", "explore"] },
    "persona_ref": { "type": "string", "minLength": 1 },
    "preconditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "start_path": {
      "type": "string",
      "maxLength": 500,
      "description": "Web path or semantic Electron start point — never hardcode host"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_destructive_actions": { "type": "boolean", "default": false },
        "allow_external_navigation": { "type": "boolean", "default": false },
        "allowed_origins": {
          "type": "array",
          "items": { "type": "string", "pattern": "^https?://" }
        },
        "redact_text_patterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpoint_policy": {
          "type": "string",
          "enum": ["each_step", "key_nodes", "failures_only"],
          "default": "key_nodes"
        },
        "capture_dom_summary": { "type": "boolean", "default": true },
        "capture_network_failures": { "type": "boolean", "default": true },
        "capture_performance": { "type": "boolean", "default": true },
        "screenshot_mode": {
          "type": "string",
          "enum": ["viewport", "full_page"],
          "default": "viewport"
        }
      }
    },
    "api_client": {
      "type": "object",
      "description": "Optional override of the API client (surface + baseUrl). When omitted, derived from .user-simulator/profile.json (ProjectProfile.api).",
      "additionalProperties": false,
      "properties": {
        "surface": { "type": "string", "enum": ["openapi", "graphql", "rest"] },
        "baseUrl": { "type": "string" }
      }
    },
    "task": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/task_step" }
    },
    "success_criteria": {
      "type": "array",
      "items": { "$ref": "#/$defs/global_assertion" }
    },
    "max_total_actions": { "type": "integer", "minimum": 1, "maximum": 500, "default": 60 },
    "goals": {
      "type": "array",
      "items": { "$ref": "#/$defs/goal" }
    },
    "coverage_targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverage_target" }
    },
    "max_steps": { "type": "integer", "minimum": 1, "maximum": 100 },
    "novelty_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "stagnation_limit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 3 },
    "excluded_areas": {
      "type": "array",
      "items": { "type": "string", "maxLength": 200 }
    },
    "stop_when_goals_met": { "type": "boolean", "default": true }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "task" } } },
      "then": {
        "required": ["task", "steps"],
        "properties": {
          "task": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/task_step" }
          },
          "success_criteria": {
            "type": "array",
            "items": { "$ref": "#/$defs/global_assertion" }
          },
          "max_total_actions": { "type": "integer", "minimum": 1, "maximum": 500, "default": 60 }
        },
        "not": {
          "anyOf": [
            { "required": ["goals"] },
            { "required": ["coverage_targets"] },
            { "required": ["novelty_threshold"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "explore" } } },
      "then": {
        "required": ["goals", "coverage_targets", "max_steps", "novelty_threshold"],
        "properties": {
          "goals": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/goal" }
          },
          "coverage_targets": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/coverage_target" }
          },
          "max_steps": { "type": "integer", "minimum": 1, "maximum": 100 },
          "novelty_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
          "stagnation_limit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 3 },
          "excluded_areas": {
            "type": "array",
            "items": { "type": "string", "maxLength": 200 }
          },
          "stop_when_goals_met": { "type": "boolean", "default": true }
        },
        "not": { "required": ["steps"] }
      }
    }
  ],
  "$defs": {
    "task_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "instruction"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 500 },
        "key_node": { "type": "boolean", "default": true },
        "max_actions": { "type": "integer", "minimum": 1, "maximum": 50 },
        "assertions": {
          "type": "array",
          "items": { "$ref": "#/$defs/step_assertion" }
        },
        "api_assertions": {
          "type": "array",
          "description": "v4: API-level assertions run after this step (parallel to assertions[]).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "expect"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
              "kind": { "type": "string", "enum": ["openapi", "graphql", "rest"] },
              "operation": { "type": "string" },
              "query": { "type": "string" },
              "variables": { "type": "object" },
              "request": {
                "type": "object",
                "properties": {
                  "method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"] },
                  "path": { "type": "string" },
                  "payload": {}
                }
              },
              "expect": {
                "type": "object",
                "properties": {
                  "status": { "type": "integer", "minimum": 100, "maximum": 599 },
                  "body": {},
                  "matches": { "type": "string" },
                  "latencyMs": { "type": "integer", "minimum": 0 }
                }
              },
              "on_step": { "type": "string" },
              "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 30000, "default": 5000 },
              "severity_on_fail": { "type": "string", "enum": ["S0", "S1", "S2", "S3"], "default": "S2" }
            }
          }
        },
        "on_failure": {
          "type": "string",
          "enum": ["continue", "stop"],
          "default": "stop"
        }
      }
    },
    "step_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "operator", "severity_on_fail"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "kind": {
          "type": "string",
          "enum": ["visible", "hidden", "text", "url", "state", "no_console_error", "no_page_error", "performance", "visual"]
        },
        "target": { "type": "string", "maxLength": 300 },
        "locator": {
          "type": "string",
          "enum": ["role", "label", "text", "test_id", "css"],
          "description": "role/label/text/test_id preferred; css only as escape hatch"
        },
        "operator": {
          "type": "string",
          "enum": ["exists", "not_exists", "equals", "contains", "matches", "lte", "gte", "changed"]
        },
        "expected": { "type": ["string", "number", "boolean"] },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 30000, "default": 5000 },
        "severity_on_fail": { "type": "string", "enum": ["S0", "S1", "S2", "S3"] },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "enum": ["screenshot", "snapshot", "log"] }
        }
      }
    },
    "global_assertion": {
      "$ref": "#/$defs/step_assertion"
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "intent", "priority"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "intent": { "type": "string", "minLength": 1, "maxLength": 300 },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
        "success_signal": { "type": "string", "maxLength": 300 }
      }
    },
    "coverage_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "minimum_interactions"],
      "properties": {
        "area": { "type": "string", "minLength": 1, "maxLength": 200 },
        "minimum_interactions": { "type": "integer", "minimum": 1, "maximum": 100 },
        "success_signal": { "type": "string", "maxLength": 300 },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    }
  }
}